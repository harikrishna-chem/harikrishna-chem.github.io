---
layout: layouts/base.njk
title: Publications
description: Publications by Harikrishna Sahu.
section: publications
---
<section class="page-hero">
  <p class="eyebrow">Publications</p>
  <h1>Publications.</h1>
  <p class="lede">A complete publication list, with recent work shown first. Selected publications are highlighted on the home page.</p>
</section>

<section class="publication-groups">
  {% for group in publications | publicationYearGroups %}
    <div class="year-group">
      <h2>{{ group.year }}</h2>
      <div class="publication-list">
        {% for publication in group.items %}
          <article class="publication-item">
            <h3 id="{{ publication.title | slugify }}">
              {% if publication.url %}
                <a href="{{ publication.url }}">{{ publication.title }}</a>
              {% else %}
                {{ publication.title }}
              {% endif %}
            </h3>
            <p>{{ publication.authors }}</p>
            <p><em>{{ publication.venue }}</em>{% if publication.details %}, {{ publication.details }}{% endif %}.</p>
          </article>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</section>
