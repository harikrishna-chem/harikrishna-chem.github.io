---
permalink: /search-index.json
eleventyExcludeFromCollections: true
---
[
{%- set firstItem = true -%}
  {
    "type": "Tools",
    "title": "Software and Tools",
    "url": "/software/",
    "date": "Research software",
    "sortDate": "0000-00-00",
    "summary": "Research software, models, datasets, and practical tools for materials discovery.",
    "tags": ["tools", "software", "research-software", "materials-informatics"],
    "content": {{ (projects | toolSearchContent) | json | safe }}
  }
  {%- set firstItem = false -%}
{%- for post in collections.posts -%}
  {%- if not firstItem %},{% endif -%}
  {
    "type": "Writing",
    "title": {{ post.data.title | json | safe }},
    "url": {{ post.url | json | safe }},
    "date": {{ (post.date | readableDate) | json | safe }},
    "sortDate": {{ (post.date | isoDate) | json | safe }},
    "summary": {{ (post.data.summary or "") | json | safe }},
    "tags": {{ (post.data.tags or []) | json | safe }},
    "content": {{ (post.templateContent | stripHtml) | json | safe }}
  }
  {%- set firstItem = false -%}
{%- endfor -%}
{%- for publication in publications -%}
  {%- if not firstItem %},{% endif -%}
  {
    "type": "Publication",
    "title": {{ publication.title | json | safe }},
    "url": {{ (publication.url or ("/publications/#" ~ (publication.title | slugify))) | json | safe }},
    "date": {{ publication.year | json | safe }},
    "sortDate": {{ (publication.year ~ "-12-31") | json | safe }},
    "summary": {{ (publication.venue ~ (", " if publication.details else "") ~ (publication.details or "")) | json | safe }},
    "tags": {{ [publication.venue, publication.year] | json | safe }},
    "content": {{ (publication.title ~ " " ~ publication.authors ~ " " ~ publication.venue ~ " " ~ publication.year ~ " " ~ (publication.details or "")) | json | safe }}
  }
  {%- set firstItem = false -%}
{%- endfor -%}
{%- for project in projects | where("tool", true) | sortByNumber("toolOrder") -%}
  {%- if not firstItem %},{% endif -%}
  {
    "type": "Tool",
    "title": {{ project.title | json | safe }},
    "url": {{ ("/software/#" ~ (project.title | slugify)) | json | safe }},
    "date": {{ (project.status or "") | json | safe }},
    "sortDate": "0000-00-00",
    "summary": {{ project.summary | json | safe }},
    "tags": {{ [project.type, project.status] | json | safe }},
    "content": {{ (project.title ~ " " ~ project.subtitle ~ " " ~ project.summary ~ " " ~ (project.bullets | join(" ")) ~ " " ~ (project.type or "") ~ " " ~ (project.status or "")) | json | safe }}
  }
  {%- set firstItem = false -%}
{%- endfor -%}
]
