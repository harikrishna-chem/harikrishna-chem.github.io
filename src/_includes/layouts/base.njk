<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if seoTitle %}
    {% set pageTitle = seoTitle %}
  {% elif title %}
    {% set pageTitle = title ~ " | " ~ site.name %}
  {% else %}
    {% set pageTitle = site.name %}
  {% endif %}
  {% set pageDescription = description or summary or site.description %}
  {% set canonicalUrl = "https://" ~ site.domain ~ page.url %}
  {% set socialImage = "https://" ~ site.domain ~ "/assets/images/hari-photo_500.jpg" %}
  {% set isWritingPost = section == "writing" and page.url != "/writing/" %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} Writing Feed" href="/feed.xml">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon/favicon-48.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon/favicon-96.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon/favicon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
  <meta name="theme-color" content="#f6f1e8">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if isWritingPost %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ socialImage }}">
  <meta property="og:image:alt" content="Photo of {{ site.name }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ socialImage }}">
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ site.name | json | safe }},
      "url": {{ ("https://" ~ site.domain ~ "/") | json | safe }}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": {{ site.name | json | safe }},
      "url": {{ ("https://" ~ site.domain ~ "/") | json | safe }},
      "image": {{ socialImage | json | safe }},
      "jobTitle": {{ site.role | json | safe }},
      "affiliation": {
        "@type": "Organization",
        "name": {{ site.organization | json | safe }}
      },
      "sameAs": [
        {% for link in site.links %}
          {{ link.url | json | safe }}{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  </script>
  {% if isWritingPost %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ (seoTitle or title) | json | safe }},
      "name": {{ title | json | safe }},
      "description": {{ pageDescription | json | safe }},
      "datePublished": {{ (page.date | isoDate) | json | safe }},
      "dateModified": {{ ((dateModified or page.date) | isoDate) | json | safe }},
      "url": {{ canonicalUrl | json | safe }},
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ canonicalUrl | json | safe }}
      },
      "author": {
        "@type": "Person",
        "name": {{ site.name | json | safe }},
        "url": {{ ("https://" ~ site.domain ~ "/") | json | safe }}
      },
      "publisher": {
        "@type": "Person",
        "name": {{ site.name | json | safe }}
      },
      "image": {{ socialImage | json | safe }},
      "articleSection": "Writing"{% if tags %},
      "keywords": {{ tags | json | safe }}{% endif %}
    }
  </script>
  {% endif %}
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/" aria-label="{{ site.name }} home">
        <img src="/assets/images/header_photo_transparent.png" alt="" width="64" height="64">
        <span>
          <strong>{{ site.name }}</strong>
          <small>{{ site.role }}</small>
        </span>
      </a>
      <div class="site-header__tools">
        <nav class="site-nav" aria-label="Main navigation">
          {% for item in site.nav %}
            <a class="site-nav__link{% if section == item.key %} is-active{% endif %}" href="{{ item.url }}">{{ item.label }}</a>
          {% endfor %}
        </nav>
        <form class="header-search" role="search" autocomplete="off">
          <label class="visually-hidden" for="header-search-input">Search writings and publications</label>
          <input id="header-search-input" type="search" placeholder="Search" aria-controls="header-search-results" aria-expanded="false">
          <div class="header-search__results" id="header-search-results" hidden></div>
        </form>
      </div>
    </div>
  </header>

  <main id="content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>&copy; {{ site.year }} {{ site.name }}</p>
      <div class="footer-links">
        {% for link in site.links %}
          <a href="{{ link.url }}">{{ link.label }}</a>
        {% endfor %}
        <a href="mailto:{{ site.email }}">Email</a>
      </div>
    </div>
  </footer>
  <script>
    (() => {
      const form = document.querySelector(".header-search");
      if (!form) return;

      const input = form.querySelector("input");
      const results = form.querySelector(".header-search__results");
      const typeRank = {
        Publication: 0,
        Writing: 1
      };
      let index = [];
      let indexLoaded = false;

      const escapeHtml = (value) => String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

      const normalize = (value) => String(value || "").toLowerCase();

      const scoreResult = (item, terms) => {
        const title = normalize(item.title);
        const summary = normalize(item.summary);
        const tags = normalize((item.tags || []).join(" "));
        const content = normalize(item.content);
        let score = 0;

        for (const term of terms) {
          if (title.includes(term)) score += 8;
          if (tags.includes(term)) score += 5;
          if (summary.includes(term)) score += 3;
          if (content.includes(term)) score += 1;
        }

        return score;
      };

      const getMatches = (query) => {
        const terms = normalize(query).split(/\s+/).filter(Boolean);
        if (!terms.length) return [];

        return index
          .map((item) => ({ item, score: scoreResult(item, terms) }))
          .filter((result) => result.score > 0)
          .sort((a, b) => {
            const typeOrder = (typeRank[a.item.type] ?? 9) - (typeRank[b.item.type] ?? 9);
            if (typeOrder) return typeOrder;

            const dateOrder = String(b.item.sortDate || "").localeCompare(String(a.item.sortDate || ""));
            if (dateOrder) return dateOrder;

            return b.score - a.score;
          });
      };

      const closeResults = () => {
        results.hidden = true;
        input.setAttribute("aria-expanded", "false");
      };

      const openResults = () => {
        results.hidden = false;
        input.setAttribute("aria-expanded", "true");
      };

      const renderResults = () => {
        const query = input.value.trim();
        if (!query) {
          closeResults();
          results.innerHTML = "";
          return;
        }

        if (!indexLoaded) {
          results.innerHTML = '<p class="header-search__message">Loading...</p>';
          openResults();
          return;
        }

        const allMatches = getMatches(query);
        const matches = allMatches.slice(0, 7);
        if (!allMatches.length) {
          results.innerHTML = '<p class="header-search__message">No matches found.</p>';
          openResults();
          return;
        }

        const matchSummary = allMatches.length > matches.length
          ? `Showing ${matches.length} of ${allMatches.length} matches`
          : allMatches.length === 1 ? "1 match" : `${allMatches.length} matches`;

        results.innerHTML = `
          <div class="header-search__summary">${matchSummary}</div>
          ${matches.map(({ item }) => `
            <a class="header-search__result" href="${escapeHtml(item.url)}">
              <span class="header-search__meta">${escapeHtml(item.type)}${item.date ? ` / ${escapeHtml(item.date)}` : ""}</span>
              <strong>${escapeHtml(item.title)}</strong>
              ${item.summary ? `<small>${escapeHtml(item.summary)}</small>` : ""}
            </a>
          `).join("")}
        `;
        openResults();
      };

      const loadIndex = () => {
        if (indexLoaded) return Promise.resolve();

        return fetch("/search-index.json")
          .then((response) => {
            if (!response.ok) throw new Error("Search index unavailable");
            return response.json();
          })
          .then((items) => {
            index = items;
            indexLoaded = true;
          })
          .catch(() => {
            indexLoaded = true;
            index = [];
          });
      };

      input.addEventListener("focus", () => {
        loadIndex().then(renderResults);
      });

      input.addEventListener("input", () => {
        loadIndex().then(renderResults);
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        loadIndex().then(() => {
          const firstMatch = getMatches(input.value.trim())[0];
          if (firstMatch) {
            window.location.href = firstMatch.item.url;
          } else {
            renderResults();
          }
        });
      });

      document.addEventListener("click", (event) => {
        if (!form.contains(event.target)) closeResults();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeResults();
      });
    })();
  </script>
</body>
</html>
